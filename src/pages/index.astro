---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar/Navbar.astro";
import Hero from "@components/Hero/Hero.astro";
import Experience from "@components/Experience/Experience.astro";
import Contact from "@components/Contact/Contact.astro";
import Footer from "@components/Footer/Footer.astro";
import { SITE, SOCIAL_LINKS, RESUME_PATH } from "@data/copy";
import { SEO, ogImagePath } from "@data/seo";
import { graph, personSchema, websiteSchema } from "@utils/seo";

export const prerender = true;

// Leads with the name and role people actually search for, rather than
// the generic "Portfolio | AlfredoPrograma".
const pageTitle = `${SITE.hero.name} — ${SITE.hero.role}`;

const contactLinks = [
  { ...SOCIAL_LINKS[0], featured: true, icon: "arrow-up-right" as const },
  { ...SOCIAL_LINKS[1], icon: "arrow-up-right" as const },
  {
    href: RESUME_PATH,
    text: SITE.contact.resumeCta,
    download: true,
    icon: "download" as const,
  },
];
---

<Layout
  title={pageTitle}
  description={SEO.description}
  ogImage={ogImagePath("home")}
  jsonLd={graph(personSchema(), websiteSchema())}
>
  <Navbar />
  <Hero />
  <Experience copy={SITE.experience} />
  <Contact copy={SITE.contact} links={contactLinks} />
  <Footer />
</Layout>
