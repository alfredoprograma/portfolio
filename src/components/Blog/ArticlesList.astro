---
import { getCollection } from "astro:content";
import Article from "./Article.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";
import { SITE } from "@data/copy";

const articles = await getCollection("articles");
const sortedArticles = articles.toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const copy = SITE.blogList;
---

<section
  class="bg-neutral-50 border-b border-neutral-200 px-6 pt-16 pb-14 md:pt-22 md:pb-18"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      as="h1"
      title={copy.title}
      description={copy.description}
      headingClass="text-[40px] md:text-[56px] leading-[1.05]"
    />
  </div>
</section>

<section class="px-6 pt-12 pb-20 md:pt-16 md:pb-24">
  <div class="max-w-4xl mx-auto">
    <div
      class="flex items-center gap-3 pb-5 mb-8 border-b border-neutral-200"
    >
      <span
        class="flex size-7 shrink-0 items-center justify-center rounded-xs bg-accent-600 font-display text-[13px] font-semibold text-white"
      >
        {sortedArticles.length}
      </span>
      <span
        class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"
      >
        {copy.articlesCount}
      </span>
    </div>

    <div class="flex flex-col gap-4">
      {
        sortedArticles.map((article) => (
          <Article
            date={article.data.date}
            excerpt={article.data.excerpt}
            slug={article.data.slug}
            title={article.data.title}
            tags={article.data.tags}
            readLabel={SITE.blogList.readArticle}
          />
        ))
      }
    </div>
  </div>
</section>
