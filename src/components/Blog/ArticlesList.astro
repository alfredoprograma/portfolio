---
import { getCollection } from "astro:content";
import Article from "./Article.astro";
import ArticleFilters from "./ArticleFilters.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";
import { SITE } from "@data/copy";

const articles = await getCollection("articles");
const sortedArticles = articles.toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Tags as the filter bar needs them: one entry per distinct tag, alphabetical,
// carrying how many articles claim it.
const tagCounts = new Map<string, number>();

for (const article of sortedArticles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = Array.from(tagCounts, ([name, count]) => ({ name, count })).sort(
  (a, b) => a.name.localeCompare(b.name)
);

const copy = SITE.blogList;

/** One lowercase haystack per card, so the client filter never re-reads DOM text. */
const searchIndex = (article: (typeof sortedArticles)[number]) =>
  [article.data.title, article.data.excerpt, ...article.data.tags]
    .join(" ")
    .toLowerCase();
---

<section
  class="bg-neutral-50 border-b border-neutral-200 px-6 pt-16 pb-14 md:pt-22 md:pb-18"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      as="h1"
      title={copy.title}
      description={copy.description}
      headingClass="text-[40px] md:text-[56px] leading-[1.05]"
    />
  </div>
</section>

<section class="px-6 pt-12 pb-20 md:pt-16 md:pb-24">
  <div class="max-w-4xl mx-auto">
    <ArticleFilters tags={tags} total={sortedArticles.length} />

    <div
      class="flex items-center gap-3 pb-5 mb-8 border-b border-neutral-200"
      aria-live="polite"
    >
      <span
        class="flex size-7 shrink-0 items-center justify-center rounded-xs bg-accent-600 font-display text-[13px] font-semibold text-white"
        data-result-count
      >
        {sortedArticles.length}
      </span>
      <span
        class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"
        data-result-label
        data-label-singular={copy.articleCount}
        data-label-plural={copy.articlesCount}
      >
        {sortedArticles.length === 1 ? copy.articleCount : copy.articlesCount}
      </span>
    </div>

    <ul class="flex flex-col gap-4 list-none m-0 p-0">
      {
        sortedArticles.map((article) => (
          <li
            data-article
            data-search={searchIndex(article)}
            data-tags={article.data.tags
              .map((tag) => tag.toLowerCase())
              .join(",")}
          >
            <Article
              date={article.data.date}
              excerpt={article.data.excerpt}
              slug={article.data.slug}
              title={article.data.title}
              tags={article.data.tags}
              readLabel={copy.readArticle}
            />
          </li>
        ))
      }
    </ul>

    <div
      data-empty
      hidden
      class="rounded-xs border border-dashed border-neutral-300 px-6 py-14 text-center"
    >
      <p
        class="font-display text-lg md:text-xl font-semibold tracking-[-0.02em] text-heading"
      >
        {copy.filters.emptyTitle}
      </p>
      <p class="mt-2 text-[15px] leading-relaxed text-body">
        {copy.filters.emptyDescription}
      </p>
      <button
        type="button"
        data-clear-filters
        class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-xs border border-neutral-200 bg-white px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-heading transition-colors hover:border-accent-600 hover:text-accent-700 focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent-600"
      >
        {copy.filters.clearFilters}
      </button>
    </div>
  </div>
</section>
