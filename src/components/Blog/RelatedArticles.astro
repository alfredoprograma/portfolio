---
import { getCollection, type CollectionEntry } from "astro:content";
import Article from "./Article.astro";
import { relatedArticles } from "@utils/articles";
import { SITE } from "@data/copy";

interface RelatedArticlesProps {
  article: CollectionEntry<"articles">;
}

type Props = RelatedArticlesProps;

const { article } = Astro.props;

const articles = await getCollection("articles");
const related = relatedArticles(article, articles);

const copy = SITE.post.related;
---

{
  // `> 0` rather than a truthiness check: Astro renders a numeric 0 as text, so
  // the shortcut would print a literal "0" on a single-post site.
  related.length > 0 && (
    <section
      aria-label={copy.title}
      class="mt-14 pt-8 border-t border-neutral-200"
    >
      <div class="w-14 h-[3px] bg-accent-600 mb-4"></div>

      <h2 class="mb-5 text-[11px] font-semibold uppercase tracking-[0.14em] text-heading">
        {copy.title}
      </h2>

      <div class="flex flex-col gap-4">
        {related.map((entry) => (
          <Article
            variant="compact"
            date={entry.data.date}
            excerpt={entry.data.excerpt}
            slug={entry.data.slug}
            title={entry.data.title}
            tags={entry.data.tags}
            readLabel={copy.readArticle}
          />
        ))}
      </div>
    </section>
  )
}
