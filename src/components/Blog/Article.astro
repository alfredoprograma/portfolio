---
import Chip from "@components/Chip/Chip.astro";
import { formatDate } from "@utils/date";
import { cn } from "@utils/cn";

interface ArticleProps {
  date: Date;
  excerpt: string;
  slug: string;
  title: string;
  tags: string[];
  readLabel: string;
  /** Compact drops the excerpt and shrinks the title, for the related grid. */
  variant?: "default" | "compact";
}

type Props = ArticleProps;

const {
  date,
  excerpt,
  slug,
  tags,
  title,
  readLabel,
  variant = "default",
} = Astro.props;

const href = `/blog/${slug}`;
const compact = variant === "compact";
---

<a
  href={href}
  aria-label={`${readLabel}: ${title}`}
  class={cn(
    "group relative block bg-white border border-neutral-200 rounded-xs transition-all duration-200 hover:-translate-y-[3px] hover:border-neutral-300 hover:shadow-[0_14px_32px_-18px_rgba(23,23,23,0.34)] active:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent-600",
    compact ? "p-5 md:p-6" : "p-6 md:px-8 md:py-7"
  )}
>
  <span
    class="absolute -left-px -top-px -bottom-px w-[3px] bg-accent-600 origin-top scale-y-0 transition-transform duration-300 ease-out group-hover:scale-y-100"
  ></span>

  <time
    class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-muted mb-2.5"
    datetime={date.toISOString()}
  >
    {formatDate(date)}
  </time>

  <h3
    class={cn(
      "font-display leading-[1.28] tracking-[-0.03em] font-semibold text-heading transition-colors group-hover:text-accent-700",
      // Without an excerpt underneath, the heading carries the gap to the tags.
      compact ? "text-[17px] md:text-[19px] mb-4" : "text-xl md:text-[23px] mb-3"
    )}
  >
    {title}
  </h3>

  {
    !compact && (
      <p class="max-w-[620px] text-[15px] md:text-base leading-relaxed text-body mb-5">
        {excerpt}
      </p>
    )
  }

  <div class="flex flex-wrap gap-2">
    {tags.toSorted().map((text) => <Chip>{text}</Chip>)}
  </div>
</a>
