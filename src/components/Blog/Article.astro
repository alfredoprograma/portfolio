---
import Chip from "@components/Chip/Chip.astro";
import Icon from "@components/Icon/Icon.astro";
import { formatDate } from "@utils/date";

interface ArticleProps {
  date: Date;
  excerpt: string;
  slug: string;
  title: string;
  tags: string[];
  readLabel: string;
}

type Props = ArticleProps;

const { date, excerpt, slug, tags, title, readLabel } = Astro.props;

const href = `/blog/${slug}`;
---

<a
  href={href}
  aria-label={`${readLabel}: ${title}`}
  class="group relative block bg-white border border-neutral-200 rounded-xs p-6 md:px-8 md:py-7 transition-all duration-200 hover:-translate-y-[3px] hover:border-neutral-300 hover:shadow-[0_14px_32px_-18px_rgba(23,23,23,0.34)] active:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent-600"
>
  <span
    class="absolute -left-px -top-px -bottom-px w-[3px] bg-accent-600 origin-top scale-y-0 transition-transform duration-300 ease-out group-hover:scale-y-100"
  ></span>

  <div class="flex items-start justify-between gap-8">
    <div class="min-w-0">
      <time
        class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-muted mb-2.5"
        datetime={date.toISOString()}
      >
        {formatDate(date)}
      </time>

      <h3
        class="font-display text-xl md:text-[23px] leading-[1.28] tracking-[-0.03em] font-semibold text-heading mb-3 transition-colors group-hover:text-accent-700"
      >
        {title}
      </h3>

      <p class="max-w-[620px] text-[15px] md:text-base leading-relaxed text-body mb-5">
        {excerpt}
      </p>

      <div class="flex flex-wrap gap-2">
        {tags.toSorted().map((text) => <Chip>{text}</Chip>)}
      </div>
    </div>

    <span
      class="hidden sm:flex shrink-0 items-center justify-center size-[38px] border border-neutral-200 rounded-xs text-muted transition-all duration-200 group-hover:bg-accent-600 group-hover:border-accent-600 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    >
      <Icon name="arrow-up-right" size={18} />
    </span>
  </div>
</a>
