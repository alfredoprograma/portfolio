---
import type { NavLinkProps } from "./NavLink.astro";
import NavLink from "./NavLink.astro";
import ButtonLink from "@components/Button/ButtonLink.astro";
import { cn } from "@utils/cn";
import { SITE } from "@data/copy";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isBlogRoute = pathname.startsWith("/blog");
const isHomeRoute = pathname === "/";

const CONTACT_HREF = "/#contact";

const navLinks: NavLinkProps[] = [
  { href: "/#about", text: SITE.nav.about, active: isHomeRoute },
  { href: "/blog", text: SITE.nav.blog, active: isBlogRoute },
];
---

<header
  class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-neutral-200"
>
  <div
    class="max-w-4xl mx-auto h-14 sm:h-16 flex items-center justify-between gap-6"
  >
    <a href="/" class="flex items-center gap-2.5 text-heading no-underline">
      <span class="block size-2.5 bg-accent-600"></span>
      <span class="font-display text-[15px] font-semibold tracking-[-0.01em]">
        {SITE.meta.brand}
      </span>
    </a>

    <div class="hidden sm:flex items-center gap-8">
      <div class="flex items-center gap-7">
        {navLinks.map((props) => <NavLink {...props} />)}
      </div>

      <ButtonLink href={CONTACT_HREF} size="sm">
        {SITE.nav.contact}
      </ButtonLink>
    </div>
  </div>

  <nav class="grid grid-cols-3 border-t border-neutral-200 sm:hidden">
    {
      navLinks.map(({ href, text, active }) => (
        <a
          href={href}
          aria-current={active ? "page" : undefined}
          class={cn(
            "flex items-center justify-center min-h-[46px] text-[13px] no-underline transition-colors",
            active
              ? "font-semibold text-heading border-b-2 border-accent-600"
              : "font-medium text-muted border-b-2 border-transparent"
          )}
        >
          {text}
        </a>
      ))
    }

    <a
      href={CONTACT_HREF}
      class="flex items-center justify-center min-h-[46px] bg-accent-600 text-white text-[13px] font-semibold no-underline transition-colors active:bg-accent-700"
    >
      {SITE.nav.contact}
    </a>
  </nav>
</header>
