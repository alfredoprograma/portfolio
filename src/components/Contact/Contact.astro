---
import ButtonLink from "@components/Button/ButtonLink.astro";
import Icon from "@components/Icon/Icon.astro";
import SectionHeading from "@components/Section/SectionHeading.astro";
import type { IconName } from "@components/Icon/Icon.astro";
import type { SiteCopy } from "@data/copy";

interface ContactLink {
  href: string;
  text: string;
  download?: boolean;
  featured?: boolean;
  icon?: IconName;
}

interface ContactProps {
  copy: SiteCopy["contact"];
  links: ContactLink[];
}

type Props = ContactProps;

const { copy, links } = Astro.props;

const { locality, country, timezone, note } = copy.availability;
const availability = `Based in ${locality}, ${country} (${timezone}) — ${note}`;
---

<section
  id="contact"
  class="scroll-mt-[102px] sm:scroll-mt-16 bg-white py-20 md:py-24 px-6"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      title={copy.title}
      description={copy.description}
      headingClass="text-[32px] md:text-[44px] leading-[1.08]"
    />

    <div class="flex flex-col sm:flex-row flex-wrap gap-3 mt-9 mb-8">
      {
        links.map(({ href, text, download, featured, icon }) => (
          <ButtonLink
            href={href}
            download={download}
            size="lg"
            variant={featured ? "fill" : "outline"}
          >
            {text}
            {icon && <Icon name={icon} size={15} />}
          </ButtonLink>
        ))
      }
    </div>

    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-5 text-[13px] text-muted">
      <span class="block size-[5px] shrink-0 bg-accent-600"></span>
      {availability}
    </p>

    <p class="text-base leading-relaxed text-body">
      {copy.emailIntro}{" "}
      <a
        href={`mailto:${copy.emailLinkText}`}
        class="font-medium text-accent-700 underline-offset-[3px] hover:underline hover:text-accent-900 transition-colors"
      >
        {copy.emailLinkText}
      </a>
    </p>
  </div>
</section>
