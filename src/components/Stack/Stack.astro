---
import SectionHeading from "@components/Section/SectionHeading.astro";
import type { SiteCopy } from "@data/copy";

interface StackProps {
  copy: SiteCopy["stack"];
}

type Props = StackProps;

const { copy } = Astro.props;
---

<section
  id="stack"
  class="scroll-mt-[102px] sm:scroll-mt-16 bg-white border-b border-neutral-200 py-20 md:py-24 px-6"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      title={copy.title}
      description={copy.subtitle}
      class="mb-12 md:mb-16"
    />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.groups.map((group) => (
          <li class="flex flex-col gap-3 border border-neutral-200 bg-neutral-50 p-6">
            <span class="block size-[7px] bg-accent-600" />

            <h3 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">
              {group.label}
            </h3>

            <ul class="flex flex-wrap gap-x-2 gap-y-1 text-[15px] leading-relaxed text-body">
              {group.items.map((item, index) => (
                <li>
                  {item}
                  {index < group.items.length - 1 && (
                    <span class="text-neutral-300" aria-hidden="true">
                      {" "}
                      &middot;
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
