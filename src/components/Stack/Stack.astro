---
import { cn } from "@utils/cn";
import SectionHeading from "@components/Section/SectionHeading.astro";
import type { SiteCopy } from "@data/copy";

interface StackProps {
  copy: SiteCopy["stack"];
}

type Props = StackProps;

const { copy } = Astro.props;
---

<section
  id="stack"
  class="scroll-mt-[102px] sm:scroll-mt-16 bg-white border-b border-neutral-200 py-20 md:py-24 px-6"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      title={copy.title}
      class="mb-12 md:mb-16"
    />

    <ul>
      {
        copy.groups.map((group, index) => (
          <li
            class={cn(
              "grid gap-1.5 md:grid-cols-[168px_minmax(0,1fr)] md:gap-10 py-5 first:pt-0",
              index > 0 && "border-t border-neutral-200"
            )}
          >
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted md:pt-1">
              {group.label}
            </h3>

            <p class="text-[15px] md:text-base leading-relaxed text-body">
              {group.items.join(" · ")}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
