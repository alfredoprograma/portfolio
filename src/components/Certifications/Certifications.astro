---
import SectionHeading from "@components/Section/SectionHeading.astro";
import Icon from "@components/Icon/Icon.astro";
import { formatMonthYear } from "@utils/date";
import type { SiteCopy } from "@data/copy";

interface CertificationsProps {
  copy: SiteCopy["certifications"];
}

type Props = CertificationsProps;

const { copy } = Astro.props;
---

<section
  id="certifications"
  class="scroll-mt-[102px] sm:scroll-mt-16 bg-neutral-50 border-b border-neutral-200 py-20 md:py-24 px-6"
>
  <div class="max-w-4xl mx-auto">
    <SectionHeading
      title={copy.title}
      class="mb-12 md:mb-16"
    />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.items.map((item) => (
          <li class="flex">
            <a
              href={item.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${copy.viewCredential}: ${item.name}`}
              class="group relative flex w-full flex-col gap-3 rounded-xs border border-neutral-200 bg-white p-6 transition-all duration-200 hover:-translate-y-[3px] hover:border-neutral-300 hover:shadow-[0_14px_32px_-18px_rgba(23,23,23,0.34)] active:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent-600"
            >
              <span class="absolute -left-px -top-px -bottom-px w-[3px] bg-accent-600 origin-top scale-y-0 transition-transform duration-300 ease-out group-hover:scale-y-100" />

              <span class="block size-[7px] bg-accent-600" />

              <h3 class="flex items-start gap-1.5 font-display text-lg leading-[1.25] tracking-[-0.02em] font-semibold text-heading transition-colors group-hover:text-accent-700">
                {item.name}
                <Icon
                  name="arrow-up-right"
                  size={14}
                  class="mt-1.5 shrink-0 text-muted transition-all duration-200 group-hover:text-accent-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </h3>

              <p class="text-[13px] leading-relaxed text-body">
                {`${formatMonthYear(item.issuedOn)} – ${formatMonthYear(item.expiresOn)}`}
              </p>

              <p class="mt-auto text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">
                {item.issuer}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
