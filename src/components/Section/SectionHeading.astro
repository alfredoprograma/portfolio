---
import { cn } from "@utils/cn";

interface SectionHeadingProps {
  title: string;
  description?: string;
  as?: "h1" | "h2";
  /** Type scale for the heading; defaults to the 46px section size. */
  headingClass?: string;
  /** Accent rule colour; lightened on dark surfaces for legibility. */
  ruleClass?: string;
  class?: string;
}

type Props = SectionHeadingProps;

const {
  title,
  description,
  as: Tag = "h2",
  headingClass = "text-[34px] md:text-[46px] leading-[1.1]",
  ruleClass = "bg-accent-600",
  class: className,
} = Astro.props;
---

<div class={className}>
  <div class={cn("w-18 h-[3px] mb-6 md:mb-[26px]", ruleClass)}></div>

  <Tag
    class={cn(
      "font-display tracking-[-0.035em] font-semibold text-heading",
      headingClass
    )}
  >
    {title}
  </Tag>

  {
    description && (
      <p class="max-w-[620px] text-base md:text-[17px] leading-relaxed text-body mt-5">
        {description}
      </p>
    )
  }
</div>
