---
import { cn } from "@utils/cn";

type ButtonVariant = "fill" | "outline";
type ButtonSize = "sm" | "lg";

interface ButtonLinkProps {
  href: string;
  download?: boolean;
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
}

type Props = ButtonLinkProps;

const {
  href,
  download,
  variant = "fill",
  size = "sm",
  class: className,
} = Astro.props;
---

<a
  download={download}
  href={href}
  class={cn(
    "inline-flex items-center justify-center gap-2.5 rounded-xs font-semibold transition-all duration-200 hover:-translate-y-px active:translate-y-0",
    {
      "bg-accent-600 text-white hover:bg-accent-700": variant === "fill",
      "bg-white border border-neutral-300 text-body hover:border-accent-600 hover:text-accent-700 hover:bg-accent-50":
        variant === "outline",
      "min-h-10 px-4 text-sm": size === "sm",
      "min-h-12 px-[26px] text-[15px]": size === "lg",
    },
    className
  )}
>
  <slot />
</a>
