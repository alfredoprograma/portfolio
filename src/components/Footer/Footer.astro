---
import { SITE, SOCIAL_LINKS } from "@data/copy";

const year = new Date().getFullYear();

const footerLinks = [
  ...SOCIAL_LINKS,
  { href: "/blog", text: SITE.nav.blog },
];
---

<footer class="surface-ink bg-ink-950 border-t border-ink-900 px-6 py-8">
  <div
    class="max-w-4xl mx-auto flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <div class="flex items-center gap-2.5">
      <span class="block size-[7px] bg-accent-500"></span>
      <p class="text-[13px] text-muted">&copy; {year} {SITE.hero.name}</p>
    </div>

    <div class="flex items-center gap-6 text-[13px]">
      {
        footerLinks.map(({ href, text }) => (
          <a
            href={href}
            class="text-muted hover:text-heading transition-colors"
          >
            {text}
          </a>
        ))
      }
    </div>
  </div>
</footer>
